# Server port (default: 8787)
PORT=8787

# Public project links used by the Links page and social metadata
VITE_APP_PUBLIC_URL=https://your-domain.example
VITE_APP_GITHUB_URL=https://github.com/your-name/ai-token-counter

# Optional bearer token required by /api/v1/* when set
TOKEN_COUNTER_API_KEY=

# OpenAI official tokenizer and model APIs
OPENAI_API_KEY=

# Anthropic Claude official count_tokens API
ANTHROPIC_API_KEY=

# Google Gemini official countTokens API
GEMINI_API_KEY=

# Z.AI (GLM) official tokenizer API
ZAI_API_KEY=
# Legacy alias for ZAI_API_KEY
ZHIPU_API_KEY=
