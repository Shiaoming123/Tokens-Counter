# Server port (default: 8787)
PORT=8787

# Public repository link used by the header GitHub icon
VITE_APP_GITHUB_URL=https://github.com/your-name/ai-token-counter

# Optional bearer token required by /api/v1/* when set
TOKEN_COUNTER_API_KEY=
TOKEN_COUNTER_API_KEYS=
TOKEN_COUNTER_RATE_LIMIT_MAX=120
TOKEN_COUNTER_RATE_LIMIT_WINDOW_MS=3600000
TOKEN_COUNTER_MAX_BODY_BYTES=262144
TOKEN_COUNTER_MAX_MODELS_PER_REQUEST=20
TOKEN_COUNTER_MAX_TEXT_BYTES=131072
TOKEN_COUNTER_MAX_MESSAGES=100
TOKEN_COUNTER_MAX_IMAGES=8
TOKEN_COUNTER_MAX_IMAGE_BYTES=2097152

# OpenAI official tokenizer and model APIs
OPENAI_API_KEY=

# Anthropic Claude official count_tokens API
ANTHROPIC_API_KEY=

# Google Gemini official countTokens API
GEMINI_API_KEY=

# Z.AI (GLM) official tokenizer API
ZAI_API_KEY=
# Legacy alias for ZAI_API_KEY
ZHIPU_API_KEY=
