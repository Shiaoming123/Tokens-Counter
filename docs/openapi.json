{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Token Counter External API",
    "version": "1.0.0",
    "description": "Public v1 API for model catalog lookup, token counting, and cost estimation. Official provider counting may send request content to the selected model provider when requested."
  },
  "x-tokenCounter-default-limits": {
    "max_body_bytes": 262144,
    "max_models_per_request": 20,
    "max_text_bytes": 131072,
    "max_messages": 100,
    "max_images": 8,
    "max_image_bytes": 2097152
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/models": {
      "get": {
        "summary": "List supported models",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "capability",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["text", "image", "coding", "messages", "cost_estimate", "official_count", "local_count"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model catalog response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Model" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/estimates": {
      "post": {
        "summary": "Create token and cost estimates",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": { "type": "string", "maxLength": 200 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EstimateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimate response",
            "headers": {
              "X-TokenCounter-Model-Count": { "$ref": "#/components/headers/TokenCounterModelCount" },
              "X-TokenCounter-Input-Tokens": { "$ref": "#/components/headers/TokenCounterInputTokens" },
              "X-TokenCounter-Official-Calls": { "$ref": "#/components/headers/TokenCounterOfficialCalls" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EstimateResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/PayloadTooLargeError" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/OfficialCountFailedError" }
        }
      }
    },
    "/tokens/count": {
      "post": {
        "summary": "Count tokens without returning cost fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EstimateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token count response",
            "headers": {
              "X-TokenCounter-Model-Count": { "$ref": "#/components/headers/TokenCounterModelCount" },
              "X-TokenCounter-Input-Tokens": { "$ref": "#/components/headers/TokenCounterInputTokens" },
              "X-TokenCounter-Official-Calls": { "$ref": "#/components/headers/TokenCounterOfficialCalls" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenCountResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/PayloadTooLargeError" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/OfficialCountFailedError" }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RateLimitLimit": {
        "description": "Total allowed requests in the current rate limit window.",
        "schema": { "type": "integer" }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining in the current rate limit window.",
        "schema": { "type": "integer" }
      },
      "RateLimitReset": {
        "description": "Unix timestamp in seconds when the current rate limit window resets.",
        "schema": { "type": "integer" }
      },
      "TokenCounterModelCount": {
        "description": "Number of models successfully counted for this request.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "TokenCounterInputTokens": {
        "description": "Aggregate input tokens across successful model results in this request.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "TokenCounterOfficialCalls": {
        "description": "Number of provider official count calls made for this request.",
        "schema": { "type": "integer", "minimum": 0 }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Error": {
        "description": "Standard error response",
        "headers": {
          "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "PayloadTooLargeError": {
        "description": "Request body, model fan-out, text, message, or image payload exceeded configured limits before provider forwarding.",
        "headers": {
          "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "textLimit": {
                "value": {
                  "error": {
                    "code": "payload_too_large",
                    "message": "input text exceeds the maximum allowed bytes",
                    "param": "input",
                    "request_id": "req_01JZ9YV61G7Y1CJQY1NE1Q4KSP",
                    "details": {
                      "maximum_text_bytes": 131072,
                      "actual_text_bytes": 196608
                    }
                  }
                }
              }
            }
          }
        }
      },
      "OfficialCountFailedError": {
        "description": "Provider official counting failed or is unavailable and local fallback was not allowed.",
        "headers": {
          "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "fallbackDisabled": {
                "value": {
                  "error": {
                    "code": "official_count_failed",
                    "message": "External API official counting is not available yet; allow fallback or use local estimates.",
                    "param": "options.allow_fallback",
                    "request_id": "req_01JZ9YW7B07R8N8DPZB0KJQEFM",
                    "details": {
                      "prefer_official_count": true,
                      "allow_fallback": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Model": {
        "type": "object",
        "required": ["model", "provider", "display_name", "capabilities", "pricing", "count_methods"],
        "properties": {
          "model": { "type": "string" },
          "provider": { "type": "string" },
          "display_name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "context_window": { "type": ["integer", "null"] },
          "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "pricing": { "$ref": "#/components/schemas/Pricing" },
          "count_methods": { "type": "object" }
        }
      },
      "Pricing": {
        "type": "object",
        "required": ["currency", "input_per_1m", "output_per_1m"],
        "properties": {
          "currency": { "type": "string" },
          "input_per_1m": { "type": "number" },
          "output_per_1m": { "type": "number" },
          "cached_input_per_1m": { "type": ["number", "null"] },
          "cache_write_per_1m": { "type": ["number", "null"] },
          "source": { "type": ["string", "null"] },
          "last_updated": { "type": ["string", "null"] }
        }
      },
      "EstimateRequest": {
        "type": "object",
        "description": "External estimate/count request. Payloads are subject to the deployment limits advertised by x-tokenCounter-default-limits.",
        "required": ["models", "input"],
        "properties": {
          "models": {
            "type": "array",
            "description": "One or more model IDs or aliases. Default preview limit is 20 models per request.",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 20
          },
          "input": { "$ref": "#/components/schemas/InputPayload" },
          "options": { "$ref": "#/components/schemas/EstimateOptions" },
          "project_id": { "type": "string" },
          "workspace_id": { "type": "string" }
        }
      },
      "InputPayload": {
        "type": "object",
        "description": "Text, messages, and image inputs to count. At least one countable content field must be present.",
        "properties": {
          "text": {
            "type": "string",
            "description": "Plain text input. Default preview limit for text plus message content is 131072 UTF-8 bytes."
          },
          "messages": {
            "type": "array",
            "description": "Chat-style messages. Default preview limit is 100 messages.",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
                "content": { "type": "string" }
              }
            }
          },
          "images": {
            "type": "array",
            "description": "Image metadata and optional inline base64. Default preview limit is 8 images and 2097152 decoded inline image bytes.",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "mime_type": { "type": "string" },
                "mimeType": { "type": "string" },
                "width": { "type": "integer" },
                "height": { "type": "integer" },
                "base64": { "type": "string" }
              }
            }
          }
        }
      },
      "EstimateOptions": {
        "type": "object",
        "properties": {
          "expected_output_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Expected output tokens used only for cost estimation."
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Compatibility alias for expected_output_tokens."
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens expected to be billed at cached input rate."
          },
          "cache_hit_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Compatibility alias for cached_input_tokens."
          },
          "cache_write_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens expected to be billed at cache write rate."
          },
          "cost_multiplier": {
            "type": "number",
            "description": "Explicit multiplier for proxy markup, discounts, or credit conversion. This is a calculation input, not a paid billing feature."
          },
          "pricing_profile": {
            "type": "string",
            "enum": ["official", "ccswitch"],
            "description": "Pricing table to use for estimates. Pricing profiles are planning metadata, not provider invoice guarantees."
          },
          "use_official_api": {
            "type": "boolean",
            "description": "Compatibility alias for prefer_official_count."
          },
          "prefer_official_count": {
            "type": "boolean",
            "description": "Prefer provider official count APIs when configured and supported. Enabling this can send text, messages, image metadata, inline image base64, and other countable content to the provider for each selected model."
          },
          "allow_fallback": {
            "type": "boolean",
            "default": true,
            "description": "Allow local estimates when official counting fails or is unavailable. If prefer_official_count or use_official_api is true and this is false, official-count failure or unavailability returns 502 official_count_failed instead of silently falling back."
          },
          "redact": {
            "type": "boolean",
            "description": "Redact prompt and image payloads from local logs or persisted records when those features exist. Redaction does not prevent provider official count APIs from receiving content when official counting is requested."
          }
        }
      },
      "InputSummary": {
        "type": "object",
        "required": ["text_bytes", "message_count", "image_count", "redacted"],
        "properties": {
          "text_bytes": { "type": "integer", "minimum": 0 },
          "message_count": { "type": "integer", "minimum": 0 },
          "image_count": { "type": "integer", "minimum": 0 },
          "redacted": { "type": "boolean" }
        }
      },
      "UsageSummary": {
        "type": "object",
        "description": "Per-response usage telemetry. This is not a persisted billing record, paid quota, or durable customer usage ledger unless a deployment separately documents that capability.",
        "required": ["request_count", "model_count", "input_tokens", "official_count_calls", "estimated_cost"],
        "properties": {
          "request_count": { "type": "integer", "minimum": 1 },
          "model_count": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "official_count_calls": { "type": "integer", "minimum": 0 },
          "estimated_cost": { "type": "number", "minimum": 0 }
        }
      },
      "TrustMetadata": {
        "type": "object",
        "description": "Trust and source metadata for a count or estimate. This metadata is descriptive and does not certify billable provider usage.",
        "required": [
          "count_accuracy",
          "count_method",
          "pricing_source",
          "pricing_last_updated",
          "pricing_verified",
          "billable_usage_note"
        ],
        "properties": {
          "count_accuracy": {
            "type": "string",
            "enum": ["official_estimate", "local_exact", "local_estimate", "unsupported", "unavailable"]
          },
          "count_method": { "type": "string" },
          "pricing_source": { "type": ["string", "null"] },
          "pricing_last_updated": { "type": ["string", "null"] },
          "pricing_verified": { "type": "boolean" },
          "billable_usage_note": {
            "type": "string",
            "description": "Provider invoice usage remains the source of truth; local estimates and pricing profiles are for planning and comparison."
          }
        }
      },
      "CountFields": {
        "type": "object",
        "required": [
          "input_tokens",
          "text_tokens",
          "image_tokens",
          "total_tokens",
          "context_window",
          "context_usage_ratio",
          "accuracy",
          "count_methods",
          "warnings",
          "trust"
        ],
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0 },
          "text_tokens": { "type": "integer", "minimum": 0 },
          "image_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "context_window": { "type": ["integer", "null"], "minimum": 0 },
          "context_usage_ratio": { "type": ["number", "null"], "minimum": 0 },
          "accuracy": {
            "type": "object",
            "required": ["text", "image", "overall"],
            "properties": {
              "text": { "type": "string" },
              "image": { "type": "string" },
              "overall": { "type": "string" }
            }
          },
          "count_methods": {
            "type": "object",
            "required": ["text", "image"],
            "properties": {
              "text": { "type": "string" },
              "image": { "type": "string" }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "trust": { "$ref": "#/components/schemas/TrustMetadata" }
        }
      },
      "EstimateCount": {
        "allOf": [
          { "$ref": "#/components/schemas/CountFields" },
          {
            "type": "object",
            "required": ["expected_output_tokens"],
            "properties": {
              "expected_output_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      },
      "CostEstimate": {
        "type": "object",
        "required": ["currency", "input", "cached_input", "cache_write", "output", "total", "pricing", "multiplier"],
        "properties": {
          "currency": { "type": "string" },
          "input": { "type": "number" },
          "cached_input": { "type": "number" },
          "cache_write": { "type": "number" },
          "output": { "type": "number" },
          "total": { "type": "number" },
          "pricing": { "oneOf": [{ "$ref": "#/components/schemas/Pricing" }, { "type": "null" }] },
          "multiplier": { "type": "number" }
        }
      },
      "EstimateResponse": {
        "type": "object",
        "required": ["id", "object", "created_at", "request_id", "input_summary", "summary", "usage", "results"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "estimate" },
          "created_at": { "type": "string", "format": "date-time" },
          "request_id": { "type": "string" },
          "input_summary": { "$ref": "#/components/schemas/InputSummary" },
          "summary": {
            "type": "object",
            "required": ["total_input_tokens", "cheapest_model", "cheapest_cost", "models_compared", "currency"],
            "properties": {
              "total_input_tokens": { "type": "integer", "minimum": 0 },
              "cheapest_model": { "type": ["string", "null"] },
              "cheapest_cost": { "type": ["number", "null"] },
              "models_compared": { "type": "integer", "minimum": 0 },
              "currency": { "type": ["string", "null"] }
            }
          },
          "usage": { "$ref": "#/components/schemas/UsageSummary" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/EstimateResult" } },
          "failures": { "type": "array" }
        }
      },
      "EstimateResult": {
        "type": "object",
        "required": ["model", "provider", "count", "cost"],
        "properties": {
          "model": { "type": "string" },
          "provider": { "type": "string" },
          "count": { "$ref": "#/components/schemas/EstimateCount" },
          "cost": { "$ref": "#/components/schemas/CostEstimate" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "trust": { "$ref": "#/components/schemas/TrustMetadata" }
        }
      },
      "TokenCountResponse": {
        "type": "object",
        "required": ["object", "created_at", "request_id", "usage", "results"],
        "properties": {
          "object": { "const": "token_count" },
          "created_at": { "type": "string", "format": "date-time" },
          "request_id": { "type": "string" },
          "usage": { "$ref": "#/components/schemas/UsageSummary" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/TokenCountResult" } },
          "failures": { "type": "array" }
        }
      },
      "TokenCountResult": {
        "allOf": [
          {
            "type": "object",
            "required": ["model", "provider"],
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" }
            }
          },
          { "$ref": "#/components/schemas/CountFields" }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "unauthorized",
                  "forbidden",
                  "rate_limited",
                  "model_not_supported",
                  "pricing_unavailable",
                  "payload_too_large",
                  "official_count_failed",
                  "internal_error"
                ]
              },
              "message": { "type": "string" },
              "param": { "type": ["string", "null"] },
              "request_id": { "type": "string" },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
